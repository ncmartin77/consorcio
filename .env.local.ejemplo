# Copiar este archivo como .env.local y completar. .env.local NO se sube a git.
# Todos los valores son del proyecto de PRUEBA de Supabase, salvo ORIGEN_DATABASE_URL.

# Base de PRUEBA — Supabase (proyecto de prueba) → Connect → "Session pooler" (funciona sin IPv6)
DATABASE_URL=postgresql://postgres.XXXXXXXXXXXXXXXXXXXX:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:5432/postgres

# Base de PRODUCCIÓN, solo para copiar_esquema.py (se abre en solo lectura) — "Session pooler" del proyecto real
ORIGEN_DATABASE_URL=postgresql://postgres.eboskxnitazzwfobwkiq:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:5432/postgres

# Storage de PRUEBA — Supabase (proyecto de prueba) → Project Settings → API Keys
SUPABASE_URL=https://XXXXXXXXXXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...
SUPABASE_BUCKET=comprobantes

# Flask
SECRET_KEY=cualquier-texto-largo-para-pruebas
APP_ENV=pruebas

# Login de prueba sin Google (solo funciona desde esta PC). Poné tu email.
DEV_LOGIN_EMAIL=tu-email@ejemplo.com
