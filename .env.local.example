# Variables para correr la app en local (scripts/correr_local.sh).
# Copiar a .env.local (no se versiona) y completar.

# Base local de docker-compose.local.yml. NUNCA poner aca la de Supabase.
DATABASE_URL=postgresql://consorcio:consorcio@127.0.0.1:55432/consorcio

APP_ENV=pruebas
APP_HOST=127.0.0.1
SECRET_KEY=cambiar-por-un-valor-largo-al-azar

# Login con Google: el cliente OAuth tiene que tener autorizada
# http://127.0.0.1:5000/auth/callback (o usar el login de desarrollo, paso A0-5).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Almacenamiento de comprobantes (paso A2). S3 local (SeaweedFS) de docker-compose.local.yml.
S3_ENDPOINT=http://127.0.0.1:59000
S3_BUCKET=comprobantes
S3_ACCESS_KEY=consorcio
S3_SECRET_KEY=consorcio-local
S3_REGION=us-east-1
